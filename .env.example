# Environment Variables Template
# JANGAN PERNAH commit file .env atau .env.local ke Git

# Konfigurasi Database Turso (untuk Vercel Production)
# Dapatkan gratis di https://turso.tech tanpa kartu kredit
TURSO_DATABASE_URL=libsql://your-database-name-organization.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Catatan:
# Jika TURSO_DATABASE_URL dikosongkan (di lingkungan lokal),
# aplikasi akan otomatis menggunakan file SQLite lokal di data/asset_retrieval.db
